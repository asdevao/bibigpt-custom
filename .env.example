# ===== BibiGPT 定制版环境变量模板 =====
# 复制为 .env 并填入你自己的凭据：cp .env.example .env

# --- LLM（任意 OpenAI 兼容厂商）---
# 商汤: https://token.sensenova.cn/v1  智谱: https://open.bigmodel.cn/api/paas/v4  DeepSeek: https://api.deepseek.com
OPENAI_API_KEY=sk-你的key
OPENAI_API_BASE_URL=https://token.sensenova.cn/v1
# 主模型（必须是非推理模型：推理模型输出走 reasoning_content，本应用会拿到空总结）
OPENAI_MODEL=deepseek-v4-flash
# 主模型 429 时的降级模型（同样必须非推理）
OPENAI_FALLBACK_MODEL=kimi-k3

# --- B站 AI 字幕（必需，过期症状：B站视频报"字幕获取失败"）---
# 浏览器登录 bilibili.com → F12 → Network → 任意 api.bilibili.com 请求 → Cookie 里 SESSDATA= 后的值
# 注意：有效期约 180 天
BILIBILI_SESSION_TOKEN=

# --- YouTube 字幕源 savesubs 的会话 token（仅 YouTube 总结需要）---
# 浏览器打开 savesubs.com 解析任意链接 → F12 → Network → /action/extract 请求头里 x-auth-token
SAVESUBS_X_AUTH_TOKEN=

# --- Upstash 云 Redis（留空 = 限流器自动停用，自部署无需配置）---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_RATE_REDIS_REST_URL=
UPSTASH_RATE_REDIS_REST_TOKEN=

# --- 站点地址（改成你的 IP:端口或域名）---
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:19368

# --- Supabase（留哑值即可，自部署不用官方登录）---
NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy.anon-key
SUPABASE_HOSTNAME=dummy.supabase.co

# --- 代理（境外字幕源 YouTube/savesubs 需要；国内服务器填可用 HTTP 代理）---
# 代理只作用于 YouTube 字幕链路；B站/LLM 接口走 NO_PROXY 直连
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,api.bilibili.com
